# Example settings for the simulator. Copy to hims.env, edit, then: set -a; . ./hims.env; set +a; ./run.sh
PMJAY_PORT=9300
# Where the HIMS receives callbacks. NHCX appends /v1/<entity>/on_* to it.
PMJAY_CALLBACK_BASE=http://localhost:8081
# The HIMS's public certificate (PEM). Leave empty if the HIMS registers one through participant/update.
PMJAY_HIMS_CERT=
# The HIMS's identity as NHA and 1518 name it. These defaults are fake.
PMJAY_PROVIDER_PARTICIPANT_CODE=1000000001@hcx
PMJAY_PROVIDER_REGISTRY_ID=IN0000000000
PMJAY_PROVIDER_ID=10001
PMJAY_PROVIDER_NAME=TEST HOSPITAL
# Optional registry policy lists (see examples/policies.example.json).
PMJAY_POLICIES=
